# Local default is SQLite so `npm run dev` works with no Docker.
# Swap to Postgres later: set the URL below and change prisma/schema.prisma
# datasource provider to "postgresql". docker-compose.yml is ready.
DATABASE_URL="file:./dev.db"

# Auth is a stub. Do not treat this as a secret.
DEMO_USER_NAME="Alex Chen"
DEMO_USER_ROLE="credit_officer"

# Public marketing site (safe to expose). See docs/marketing.md.
# NEXT_PUBLIC_SITE_URL="https://mozart.financial"
# NEXT_PUBLIC_FOUNDER_EMAIL="start@mozart.financial"
# NEXT_PUBLIC_CAL_URL="https://cal.com/parth-mozart/20min"
# Quote delivery (server-only). If both are unset, /api/quote returns a mailto draft.
# RESEND_API_KEY=""
# RESEND_FROM="Mozart Quotes <quotes@mozart.financial>"
# FORMSPREE_FORM_ID=""
