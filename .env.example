# Local default is SQLite so `npm run dev` works with no Docker.
# Swap to Postgres later: set the URL below and change prisma/schema.prisma
# datasource provider to "postgresql". docker-compose.yml is ready.
DATABASE_URL="file:./dev.db"

# Auth is a stub. Do not treat this as a secret.
DEMO_USER_NAME="Alex Chen"
DEMO_USER_ROLE="credit_officer"
